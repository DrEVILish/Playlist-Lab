{
  "name": "@playlist-lab/server",
  "version": "2.5.0",
  "description": "Playlist Lab API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build && node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('dist/database',{recursive:true});fs.copyFileSync('src/database/schema.sql','dist/database/schema.sql');\"",
    "start": "node dist/index.js",
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true});if(fs.existsSync('tsconfig.tsbuildinfo'))fs.rmSync('tsconfig.tsbuildinfo');\"",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:property": "jest --testPathPattern=property",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:migration": "node ../../scripts/test-mix-templates-migration.js"
  },
  "dependencies": {
    "@playlist-lab/shared": "file:../../packages/shared",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.5",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.5.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "kuromoji": "^0.1.2",
    "multer": "^2.1.0",
    "node-cron": "^4.6.0",
    "puppeteer": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "wanakana": "^5.3.1",
    "winston": "^3.11.0",
    "youtubei.js": "^18.0.0",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^30.0.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "fast-check": "^4.9.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
