# Playlist Lab Server Configuration
# Copy this file to .env and update with your values. The binary reads its
# process environment. Use EnvironmentFile=/path/to/.env with systemd, or
# run `set -a; . ./.env; set +a` in your shell before starting the binary.
# See internal/config/config.go for the authoritative list and defaults.

# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Security
# Required in production. This key protects stored OAuth tokens/API keys.
# Generate once with `openssl rand -hex 32` and keep the same key on upgrades.
SESSION_SECRET=
TRUST_PROXY=false
# Set false only if browsers connect directly over HTTP.
COOKIE_SECURE=true

# Database
DATABASE_PATH=./data/playlist-lab.db

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Plex
PLEX_CLIENT_ID=playlist-lab-server

# Browser-backed imports require Chromium with its sandbox enabled. Install
# Chromium and run the server under a non-root service account.

# Background Jobs (each job's own flag applies in production)
ENABLE_JOBS=true
ENABLE_CACHE_CLEANUP=true
ENABLE_SCRAPER_JOB=true
SCRAPER_SCHEDULE="0 2 * * *"
ENABLE_SCHEDULE_CHECKER=true
SCHEDULE_CHECKER_SCHEDULE="0,10,20,30,40,50 * * * *"

# deemix (for downloading missing tracks) - talks to Deezer directly, no
# separate deemix-server process needed. ARL can also be set live from the
# admin panel; that overrides this file. Get a fresh ARL from your Deezer
# account's cookies if downloads start failing - it expires every few months.
DEEMIX_ARL=
ENABLE_DEEMIX_ARL_CHECK=true
DEEMIX_ARL_CHECK_SCHEDULE="0 4 * * *"

# Lidarr (optional - can also be set live from the admin panel)
# LIDARR_URL=http://127.0.0.1:8686
# LIDARR_API_KEY=your-lidarr-api-key

# Spotify import/cross-import (optional)
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# SPOTIFY_REDIRECT_URI=https://your-domain/cross-import/oauth/spotify/callback

# YouTube OAuth for cross-import/matching (optional - can also be set live
# from the admin panel's YouTube tab)
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REDIRECT_URI=https://your-domain/cross-import/oauth/youtube/callback
