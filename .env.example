# Playlist Lab Server Configuration
# Copy this file to .env and update with your values.
# See internal/config/config.go for the authoritative list and defaults.

# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
PUBLIC_URL=http://127.0.0.1:3001

# Security
# Required in production - the binary refuses to start with the default
# value once NODE_ENV=production, since it's also the AES key protecting
# stored OAuth tokens/API keys. Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string-in-production
TRUST_PROXY=false
COOKIE_SECURE=false

# Database
DATABASE_PATH=./data/playlist-lab.db

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Plex
PLEX_CLIENT_ID=playlist-lab-server

# Background Jobs (always enabled in production regardless of these flags)
ENABLE_JOBS=true
ENABLE_CACHE_CLEANUP=true
ENABLE_SCRAPER_JOB=true
SCRAPER_SCHEDULE=0 2 * * *
ENABLE_SCHEDULE_CHECKER=true
SCHEDULE_CHECKER_SCHEDULE=0,10,20,30,40,50 * * * *

# deemix (for downloading missing tracks) - base URL of your deemix-server instance.
# ARL/URL can also be set live from the admin panel; those override this file.
DEEMIX_URL=http://127.0.0.1:6595
# Only needed if the admin Deemix settings panel should be able to save
# changes - path to deemix-server's own config.json and its systemd unit
# name, so a save can write the file and restart it to apply.
DEEMIX_CONFIG_PATH=/opt/deemix-server/config/config.json
DEEMIX_SERVICE_NAME=deemix-server.service
ENABLE_DEEMIX_ARL_CHECK=true
DEEMIX_ARL_CHECK_SCHEDULE=0 4 * * *

# Lidarr (optional - can also be set live from the admin panel)
# LIDARR_URL=http://127.0.0.1:8686
# LIDARR_API_KEY=your-lidarr-api-key

# Spotify import/cross-import (optional)
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# SPOTIFY_REDIRECT_URI=https://your-domain/cross-import/oauth/spotify/callback

# YouTube OAuth for cross-import/matching (optional - can also be set live
# from the admin panel's YouTube tab)
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REDIRECT_URI=https://your-domain/cross-import/oauth/youtube/callback
